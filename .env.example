# Set to true to gate the entire site behind the Coming Soon page.
# Any route rewrites to /coming-soon while this is enabled.
COMING_SOON=false

# Absolute site URL used for Open Graph / Twitter share previews.
NEXT_PUBLIC_SITE_URL=https://nerdlogic.dev

# Google Analytics measurement ID (gtag.js). Leave empty to disable.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
